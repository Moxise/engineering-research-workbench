{
  "id": "reader-assist",
  "name": "阅读区 AI 助手",
  "version": "1.0.0",
  "description": "阅读区 AI 助手：选中段落翻译 / 总结 / 整理、自定义指令、多模态截图，结果可写回笔记。停用后阅读区不出现 AI tab 与 AI 工具条按钮。",
  "api_version": 1,
  "core_min": "v261009.14",
  "kind": "inprocess",
  "distribution": "bundled",
  "default_enabled": true,
  "permissions": [
    "ui:panel"
  ],
  "requires": {
    "plugins": [
      {
        "id": "literature-reader"
      }
    ]
  },
  "panel": {
    "mount": "web/panel.js",
    "style": "web/panel.css"
  }
}
