{
  "id": "literature-reader",
  "name": "文献阅读工作区",
  "version": "1.1.0",
  "description": "PDF 阅读工作区：打开 / 翻页 / 缩放 / 跳页、批注增改删、阅读区 tab 宿主。文献数据与文件服务在内核；停用后文献列表页照常可用。",
  "api_version": 1,
  "core_min": "v261009.14",
  "kind": "inprocess",
  "distribution": "bundled",
  "default_enabled": true,
  "permissions": [
    "ui:panel"
  ],
  "panel": {
    "mount": "web/panel.js",
    "style": "web/panel.css"
  }
}
