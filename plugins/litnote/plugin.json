{
  "id": "litnote",
  "name": "文献笔记",
  "version": "1.1.0",
  "description": "文献笔记的编辑界面 + 文献侧 AI 工具（读文献上下文 / 写文献笔记）",
  "api_version": 1,
  "core_min": "v261009",
  "kind": "inprocess",
  "distribution": "bundled",
  "default_enabled": true,
  "entry": "backend.py",
  "permissions": ["ui:panel", "storage:own"],
  "panel": { "mount": "web/panel.js" },
  "mcp_tools": ["context", "note_write"],
  "routes": [
    { "method": "GET", "path": "note" },
    { "method": "POST", "path": "note" },
    { "method": "POST", "path": "note-image" }
  ]
}
