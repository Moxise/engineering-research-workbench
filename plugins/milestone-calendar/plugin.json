{
  "id": "milestone-calendar",
  "name": "日历与提醒",
  "version": "1.0.0",
  "description": "里程碑与待办的日历视图 + 顶栏常驻角标（逾期/今日/近期待办一眼可见）",

  "api_version": 1,
  "core_min": "v261009.24",

  "kind": "inprocess",
  "distribution": "optional",
  "default_enabled": false,

  "entry": "backend.py",

  "permissions": ["ui:panel", "config:own"],

  "nav": [
    { "id": "milestone-calendar", "label": "日历提醒", "icon": "▦", "mount": "web/panel.js" },
    { "id": "milestone-calendar-badge", "label": "到期", "icon": "⚠", "slot": "topbar",
      "mount": "web/panel.js" }
  ],
  "panel": { "mount": "web/panel.js", "style": "web/panel.css" },

  "routes": [
    { "method": "GET", "path": "agenda" },
    { "method": "GET", "path": "config" },
    { "method": "POST", "path": "config" }
  ],
  "mcp_tools": ["agenda"]
}
