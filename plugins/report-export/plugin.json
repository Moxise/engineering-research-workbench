{
  "id": "report-export",
  "name": "报告导出",
  "version": "1.0.0",
  "description": "把项目/某类条目整理成交付文档：DOCX（零依赖）、HTML（浏览器打印即成 PDF）、Markdown",

  "api_version": 1,
  "core_min": "v261009.23",

  "kind": "inprocess",
  "distribution": "optional",
  "default_enabled": false,

  "entry": "backend.py",

  "permissions": ["ui:panel", "storage:own", "config:own"],

  "nav": [
    { "id": "report-export", "label": "报告导出", "icon": "▤", "mount": "web/panel.js" }
  ],
  "panel": { "mount": "web/panel.js", "style": "web/panel.css" },

  "routes": [
    { "method": "GET", "path": "capabilities" },
    { "method": "GET", "path": "scopes" },
    { "method": "POST", "path": "preview" },
    { "method": "POST", "path": "export" },
    { "method": "GET", "path": "download" },
    { "method": "GET", "path": "view" }
  ],
  "mcp_tools": ["list_scopes", "export_report"]
}
